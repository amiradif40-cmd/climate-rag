# ═══════════════════════════════════════════════════════════════════
# 🌍 ClimateRAG — Configuration complète
# Renommer ce fichier en .env et adapter les valeurs
# ═══════════════════════════════════════════════════════════════════

# ─── API LLM (obligatoire) ─────────────────────────────────────────
# Obtenez une clé gratuite sur : https://console.groq.com
GROQ_API_KEY=gsk_VOTRE_CLE_API_ICI

# Modèle Groq utilisé pour la génération
LLM_MODEL=openai/gpt-oss-20b
# ─── Modèles d'embeddings ──────────────────────────────────────────
MODEL_EMBEDDING=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_RERANKER=BAAI/bge-reranker-v2-m3

# ─── Chunking ──────────────────────────────────────────────────────
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# ─── Retrieval ─────────────────────────────────────────────────────
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# ─── FAISS ─────────────────────────────────────────────────────────
FAISS_INDEX_PATH=data/index/climate_index